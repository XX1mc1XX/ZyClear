QMainWindow {
    background-color: #1e1e1e;
}
QWidget {
    background-color: #1e1e1e;
    color: #cccccc;
    font-size: 13px;
}
QToolTip {
    background-color: #252526;
    color: #ffffff;
    border: 1px solid #3c3c3c;
    padding: 4px;
}
QFrame#Control_Frame,
#ViewConrol_Frame,
#Param_Frame {
    background-color: #181818;
    border: 1px solid #2b2b2b;
}
QPushButton#Enumeration_Button,
#LoadConfig_Button,
#SaveConfig_Button,
#Connect_Button,
#Grabbing_Button,
#Refresh_Button {
    background-color: transparent;
    border: 1px solid transparent;
    width: 28px;
    height: 28px;
    padding: 4px;
}
QPushButton#Enumeration_Button:hover,
#LoadConfig_Button:hover,
#SaveConfig_Button:hover,
#Connect_Button:hover,
#Grabbing_Button:hover,
#Refresh_Button:hover {
    background-color: #2a2d2e;
    border: 1px solid #3c3c3c;
}
QPushButton#Enumeration_Button:pressed,
#LoadConfig_Button:pressed,
#SaveConfig_Button:pressed,
#Connect_Button:pressed,
#Grabbing_Button:pressed,
#Refresh_Button:pressed {
    background-color: #04395e;
    border: 1px solid #007fd4;
}
QPushButton#Enumeration_Button { image: url(:/Enumeration.png); }
QPushButton#LoadConfig_Button { image: url(:/LoadConfig.png); }
QPushButton#SaveConfig_Button { image: url(:/SaveConfig.png); }
QPushButton#Connect_Button { image: url(:/Connect.png); }
QPushButton#Grabbing_Button { image: url(:/StratGrab.png); }
QPushButton#Refresh_Button { image: url(:/Refresh.png); }
QPushButton {
    color: #cccccc;
    background-color: #0e639c;
    border: 1px solid #0e639c;
    padding: 5px 12px;
}
QPushButton:hover {
    background-color: #1177bb;
    color: #ffffff;
}
QPushButton:pressed {
    background-color: #04395e;
}
QPushButton:disabled {
    color: #858585;
    background-color: #333333;
    border: 1px solid #3c3c3c;
}
QLabel {
    color: #cccccc;
    background-color: transparent;
}
QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox, QDateTimeEdit, QDateEdit, QTimeEdit {
    color: #cccccc;
    background-color: #3c3c3c;
    border: 1px solid #3c3c3c;
    padding: 3px 6px;
    selection-background-color: #264f78;
}
QLineEdit:focus, QComboBox:focus, QSpinBox:focus, QDoubleSpinBox:focus {
    border: 1px solid #007fd4;
}
QComboBox QAbstractItemView {
    color: #cccccc;
    background-color: #252526;
    selection-color: #ffffff;
    selection-background-color: #04395e;
    border: 1px solid #3c3c3c;
}
QComboBox::drop-down {
    border: none;
    width: 20px;
}
QCheckBox, QRadioButton {
    color: #cccccc;
    spacing: 6px;
    background-color: transparent;
}
QCheckBox::indicator, QRadioButton::indicator {
    width: 14px;
    height: 14px;
}
QCheckBox::indicator:unchecked {
    border: 1px solid #858585;
    background-color: #3c3c3c;
}
QCheckBox::indicator:checked {
    border: 1px solid #0e639c;
    background-color: #0e639c;
}
QRadioButton::indicator:unchecked {
    border: 1px solid #858585;
    border-radius: 8px;
    background-color: #3c3c3c;
}
QRadioButton::indicator:checked {
    border: 1px solid #0e639c;
    border-radius: 8px;
    background-color: #0e639c;
}
QMenuBar {
    color: #cccccc;
    background-color: #181818;
    padding: 2px;
}
QMenuBar::item {
    padding: 5px 10px;
    background-color: transparent;
}
QMenuBar::item:selected {
    background-color: #04395e;
    color: #ffffff;
}
QMenu {
    color: #cccccc;
    background-color: #252526;
    border: 1px solid #3c3c3c;
}
QMenu::item {
    padding: 6px 24px 6px 12px;
}
QMenu::item:selected {
    background-color: #04395e;
    color: #ffffff;
}
QMenu::separator {
    height: 1px;
    background-color: #3c3c3c;
    margin: 4px 8px;
}
QTabWidget::pane {
    border: 1px solid #2b2b2b;
    background-color: #1e1e1e;
}
QTabBar::tab {
    color: #9d9d9d;
    background-color: #181818;
    border: 1px solid #2b2b2b;
    border-bottom: none;
    padding: 6px 14px;
    margin-right: 2px;
}
QTabBar::tab:selected {
    color: #ffffff;
    background-color: #1e1e1e;
    border-top: 1px solid #007fd4;
}
QTabBar::tab:hover:!selected {
    background-color: #2a2d2e;
    color: #ffffff;
}
QTreeView, QListWidget, QTableView {
    color: #cccccc;
    background-color: #252526;
    alternate-background-color: #2a2d2e;
    border: 1px solid #2b2b2b;
    outline: none;
}
QTreeView::item, QListWidget::item, QTableView::item {
    padding: 4px;
    border: none;
}
QTreeView::item:selected, QListWidget::item:selected, QTableView::item:selected {
    background-color: #04395e;
    color: #ffffff;
}
QTreeView::item:hover:!selected, QListWidget::item:hover:!selected {
    background-color: #2a2d2e;
}
QTextBrowser {
    color: #cccccc;
    background-color: #252526;
    border: 1px solid #2b2b2b;
    selection-background-color: #264f78;
}
QHeaderView::section {
    color: #cccccc;
    background-color: #181818;
    border: none;
    border-right: 1px solid #1e1e1e;
    padding: 5px;
}
QSlider::groove:horizontal {
    height: 4px;
    background: #3c3c3c;
}
QSlider::groove:vertical {
    width: 4px;
    background: #3c3c3c;
}
QSlider::handle:horizontal {
    background: #cccccc;
    border: none;
    width: 13px;
    margin: -5px 0;
    border-radius: 6px;
}
QSlider::handle:vertical {
    background: #cccccc;
    border: none;
    height: 13px;
    margin: 0 -5px;
    border-radius: 6px;
}
QSlider::handle:hover {
    background: #007fd4;
}
QSlider::sub-page:horizontal, QSlider::sub-page:vertical {
    background: #0e639c;
}
QSlider::add-page:horizontal, QSlider::add-page:vertical {
    background: #3c3c3c;
}
QScrollBar:horizontal {
    height: 14px;
    background: #1e1e1e;
    margin: 0;
    border: none;
}
QScrollBar::handle:horizontal {
    background: #3c3c3c;
    min-width: 30px;
}
QScrollBar::handle:horizontal:hover {
    background: #007fd4;
}
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal,
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    background: none;
    border: none;
    width: 0;
    height: 0;
}
QScrollBar:vertical {
    width: 14px;
    background: #1e1e1e;
    margin: 0;
    border: none;
}
QScrollBar::handle:vertical {
    background: #3c3c3c;
    min-height: 30px;
}
QScrollBar::handle:vertical:hover {
    background: #007fd4;
}
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal,
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: none;
}
QSplitter::handle:horizontal {
    width: 3px;
    background: #181818;
}
QSplitter::handle:vertical {
    height: 3px;
    background: #181818;
}
QSplitter::handle:hover {
    background: #007fd4;
}
QStatusBar {
    color: #9d9d9d;
    background-color: #181818;
    border-top: 1px solid #2b2b2b;
}
QStatusBar QLabel {
    color: #cccccc;
    background-color: transparent;
}
QStatusBar::item {
    border: none;
}
QGraphicsView {
    background-color: #000000;
    border: 1px solid #2b2b2b;
}
QProgressBar {
    text-align: center;
    color: #ffffff;
    background-color: #3c3c3c;
    border: none;
    height: 12px;
}
QProgressBar::chunk {
    background-color: #0e639c;
}
QGroupBox {
    color: #cccccc;
    border: 1px solid #2b2b2b;
    margin-top: 12px;
    padding-top: 6px;
    background-color: #252526;
}
QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 4px;
    color: #ffffff;
}
QDialog, QMessageBox {
    background-color: #1e1e1e;
}
QSpinBox::up-button, QSpinBox::down-button,
QDoubleSpinBox::up-button, QDoubleSpinBox::down-button {
    background-color: #3c3c3c;
    border: none;
    width: 16px;
}
QSpinBox::up-button:hover, QSpinBox::down-button:hover {
    background-color: #0e639c;
}
